{
  "name": "dsh-yimu-bill",
  "version": "0.2.5",
  "type": "module",
  "description": "一木记账：扫码登录 +「记账模式」。入口：dsh-go App 设置 → 插件 → 一木记账；网页版 设置 → 一木记账。",
  "author": "MeiXu6693",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "yimu",
    "yimubill",
    "bookkeeping"
  ],
  "homepage": "https://github.com/MeiXu6693/dsh-yimu-bill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeiXu6693/dsh-yimu-bill.git"
  },
  "bugs": {
    "url": "https://github.com/MeiXu6693/dsh-yimu-bill/issues"
  },
  "main": "./plugin.mjs",
  "exports": {
    ".": "./plugin.mjs",
    "./tools": "./tools.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "plugin.mjs",
    "lib",
    "tools.mjs",
    "mcp-host.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "DEVELOPMENT.md",
    "LICENSE",
    "preset.example.yml"
  ],
  "scripts": {
    "test": "node --test test/plugin.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "yimu-bill-cloud-mcp": "^0.2.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "一木记账",
      "en": "Yimu Bill"
    },
    "icon": "wallet",
    "minApp": "1.3.0",
    "contributes": {
      "panels": [
        {
          "id": "yimu-login",
          "title": {
            "zh": "一木记账",
            "en": "Yimu Bill"
          },
          "icon": "qr",
          "placement": [
            "plugin"
          ]
        }
      ]
    }
  }
}
