{
  "name": "dsh-yimu-bill",
  "version": "0.2.0",
  "type": "module",
  "description": "DSH 插件：一木记账 GUI 扫码登录 + 「记账模式」预设 + 私有托管的 yimu-bill-cloud-mcp 兼容层",
  "author": "MeiXu6693",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "yimu",
    "yimubill",
    "bookkeeping"
  ],
  "homepage": "https://github.com/MeiXu6693/dsh-yimu-bill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeiXu6693/dsh-yimu-bill.git"
  },
  "bugs": {
    "url": "https://github.com/MeiXu6693/dsh-yimu-bill/issues"
  },
  "main": "./plugin.mjs",
  "exports": {
    ".": "./plugin.mjs",
    "./tools": "./tools.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.mjs",
    "lib",
    "tools.mjs",
    "mcp-host.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "preset.example.yml"
  ],
  "scripts": {
    "test": "node --test test/plugin.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
